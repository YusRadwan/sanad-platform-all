# Production environment template for the SANAD Teacher platform backend.
#
# This is NOT a drop-in copy of .env.example — every value below is either the
# production-safe counterpart of a dev default, or a value that MUST be
# generated/filled per deployment. Copy this file to `.env` on the production
# host, fill in the blanks, then run `php artisan key:generate` if APP_KEY is
# still empty. Never commit the real `.env`.
#
# See docs/DEPLOYMENT.md for the full runbook this file is one part of.

APP_NAME=Sanad
APP_ENV=production
APP_KEY=
# APP_DEBUG=false IS NOT OPTIONAL. A true value turns every unhandled
# exception into a stack trace in the HTTP response — file paths, query
# bindings, environment values. This is the single most consequential flag
# in this file.
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Same two daily-rotating channels as dev (config/logging.php), just quieter:
# 'debug' in dev would log every query/response detail Laravel's 'debug'
# level captures; production wants 'info' and up. LOG_DAILY_DAYS/
# LOG_SECURITY_DAILY_DAYS control retention — Laravel's `daily` driver
# deletes its own files past this age, no external logrotate needed for
# expiry (see docs/DEPLOYMENT.md §7 for what logrotate still adds: gzip).
LOG_CHANNEL=app
LOG_STACK=app
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=30
LOG_SECURITY_LEVEL=info
LOG_SECURITY_DAILY_DAYS=180

# A dedicated production database — never point this at the dev or test
# databases (sanad_platform_v2 / sanad_platform_v2_test).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanad_platform_v2_production
DB_USERNAME=
DB_PASSWORD=

# ─── Cookies: the load-bearing production difference from .env.example ─────
#
# SESSION_SECURE_COOKIE=true means the browser refuses to send the session
# cookie over plain HTTP. This is only safe — and only actually enforced —
# because Nginx (backend/public/nginx.conf.example) redirects :80 to :443
# and terminates TLS, and its `fastcgi_param HTTPS on;` tells PHP the request
# is secure so both this flag and App\Http\Middleware\SecurityHeaders' HSTS
# header behave correctly. Deploying this file's SESSION_SECURE_COOKIE=true
# behind plain HTTP would make every session cookie silently undeliverable —
# logins would appear to succeed and then immediately look logged out.
SESSION_DRIVER=file
SESSION_COOKIE=sanad_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Double-submit CSRF — unchanged from dev, see
# App\Http\Middleware\VerifyCsrfToken for why this diverges from Laravel's
# default XSRF-TOKEN/X-XSRF-TOKEN pair.
CSRF_COOKIE=sanad_csrf
CSRF_HEADER=X-CSRF-Token

# The real frontend origin(s) only — never "*", the frontend sends
# credentials and a wildcard cannot be combined with
# CORS_ALLOW_CREDENTIALS=true (browsers reject that combination outright).
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sanad.local"
MAIL_FROM_NAME="${APP_NAME}"

# Seeded once via `php artisan db:seed --class=AdminUserSeeder`. Leave blank
# in this committed template; set it only in the real, uncommitted .env —
# the seeder refuses to run without it.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@sanad.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME="مدير النظام"

# ─── PHP-FPM ini values worth setting explicitly in production ─────────────
# (not read from this file — set them in the php.ini / pool conf the FPM
# service actually loads; recorded here so the two are edited together)
#
#   post_max_size       200M   # match backend/public/nginx.conf.example's
#   upload_max_filesize 200M   # client_max_body_size — see that file's
#                               # comment on open decision 10.22 (no app-level
#                               # per-kind upload size limit exists on purpose)
#   max_input_vars      1000   # Laravel's default; already the case locally
#   expose_php          Off    # SecurityHeaders already strips X-Powered-By,
#                               # this closes the same leak one layer lower
#   display_errors      Off    # APP_DEBUG=false already prevents Laravel
#                               # from leaking a trace; this prevents a raw
#                               # PHP fatal (fatal BEFORE Laravel boots) from
#                               # doing the same thing at a lower layer
