APP_NAME=Sanad
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Two daily-rotating channels, mirroring backend/app/Core/Logger.php:
#   app-YYYY-MM-DD.log       general / 5xx / other 4xx
#   security-YYYY-MM-DD.log  auth + security events (401/403)
LOG_CHANNEL=app
LOG_STACK=app
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# NEVER point this at sanad_platform_test — that database belongs to backend/.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanad_platform_v2
DB_USERNAME=root
DB_PASSWORD=

# Cookie-based session auth, no JWT. Names/lifetime must match what the
# fixed frontend already sends (frontend/src/services/api.ts).
SESSION_DRIVER=file
SESSION_COOKIE=sanad_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Double-submit CSRF. Deliberately NOT Laravel's encrypted XSRF-TOKEN /
# X-XSRF-TOKEN pair: the frontend is fixed and reads an UNENCRYPTED
# `sanad_csrf` cookie and echoes it back as `X-CSRF-Token`.
CSRF_COOKIE=sanad_csrf
CSRF_HEADER=X-CSRF-Token

# Comma-separated. The literal Origin is reflected back (never "*") because
# the frontend sends credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sanad.local"
MAIL_FROM_NAME="${APP_NAME}"

# Seeded by database/seeders/AdminUserSeeder.php. Leave the password blank in
# committed files — the seeder refuses to run without it being supplied.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@sanad.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME="مدير النظام"
